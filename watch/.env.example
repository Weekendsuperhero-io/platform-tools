# Copy to watch/.env and fill in. Do not commit .env.
# Values may be the secret itself, or a 1Password reference:
#   op://Vault/Item/field
#
# Then from watch/:  pnpm secrets:sync

# Org that owns the reusable-workflow consumers
GITHUB_ORG=Weekendsuperhero-io

# Workers.dev URL from `wrangler deploy` (no trailing slash)
MUSE_WATCH_URL=https://muse-watch.gk8b9qcr52.workers.dev

# Shared HMAC — same string on the Worker and as the org GitHub secret
# Generate once: openssl rand -hex 32
MUSE_WATCH_HMAC=op://Private/muse-watch/hmac

# Same Jules key GitHub Actions already uses to create sessions
JULES_API_KEY=op://Private/Jules/credential

# Fine-grained PAT: org Weekendsuperhero-io, all repos, Contents: read/write
GITHUB_DISPATCH_TOKEN=op://Private/muse-watch/github-dispatch-token

# Optional — also pushed to the GitHub org if set
# LINEAR_API_KEY=op://Private/Linear/credential
