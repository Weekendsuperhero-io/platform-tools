module platform.workflows.actionlint

import "runners.pkl"

`self-hosted-runner` { labels = runners.labels }

output {
  renderer = new YamlRenderer { mode = "1.2" }
  text = "# Generated by .github/index.pkl. DO NOT EDIT.\n# Regenerate with `scripts/render-workflows.sh`.\n" + renderer.renderDocument(value)
}
